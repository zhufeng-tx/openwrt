#!/bin/sh /etc/rc.common

START=60

USE_PROCD=1

PROG="/usr/sbin/openwrt-mcpd"

append_arg() {
	local cfg="$1"
	local var="$2"
	local opt="$3"
	local def="$4"
	local val

	config_get val "$cfg" "$var"
	[ -n "$val" -o -n "$def" ] && procd_append_param command "$opt" "${val:-$def}"
}

start_instance() {
	local cfg="$1"
	local enabled

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -gt 0 ] || return

	procd_open_instance
	procd_set_param command "$PROG"
	append_arg "$cfg" port "-p" "8765"
	append_arg "$cfg" endpoint "-e" "/mcp"
	append_arg "$cfg" timeout_ms "-t" "30000"
	append_arg "$cfg" max_output_bytes "-o" "262144"
	append_arg "$cfg" max_request_bytes "-r" "1048576"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load openwrt-mcpd
	config_foreach start_instance mcpd
}

service_triggers() {
	procd_add_reload_trigger "openwrt-mcpd"
}
