#!/bin/sh

# shellcheck disable=SC3043

# shellcheck source=/dev/null
. /usr/share/libubox/jshn.sh
# shellcheck source=/dev/null
. /lib/functions/network.sh

APP_CONFIG="ipv6test"
APP_SECTION="main"
DEFAULT_MODE="stateless"
DEFAULT_PREFIX="fd42:6970:7636:1::/64"
DEFAULT_PD_PREFIX="fd42:6970:7636::/48"
STATE_DIR="/tmp/ipv6-test-mode"
LAST_ERROR_FILE="$STATE_DIR/last_error"
MANAGED_PACKAGES="network dhcp firewall $APP_CONFIG"

log_error() {
	logger -t ipv6-test-mode "$1"
}

set_last_error() {
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$1" > "$LAST_ERROR_FILE"
	log_error "$1"
}

clear_last_error() {
	rm -f "$LAST_ERROR_FILE"
}

read_last_error() {
	[ -r "$LAST_ERROR_FILE" ] && sed -n '1p' "$LAST_ERROR_FILE"
}

validate_mode() {
	case "$1" in
	stateless|stateful|stateless_pd) return 0 ;;
	*) return 1 ;;
	esac
}

normalize_prefix() {
	printf '%s' "$1" | tr 'A-F' 'a-f'
}

validate_prefix() {
	printf '%s\n' "$1" | grep -Eq '^fd[0-9a-f]{2}(:[0-9a-f]{1,4}){3}::/64$'
}

validate_pd_prefix() {
	case "$1" in
	*/48) printf '%s\n' "$1" | grep -Eq '^fd[0-9a-f]{2}(:[0-9a-f]{1,4}){2}::/48$' ;;
	*/52) printf '%s\n' "$1" | grep -Eq '^fd[0-9a-f]{2}(:[0-9a-f]{1,4}){2}:[0-9a-f]000::/52$' ;;
	*/56) printf '%s\n' "$1" | grep -Eq '^fd[0-9a-f]{2}(:[0-9a-f]{1,4}){2}:[0-9a-f]{2}00::/56$' ;;
	*/60) printf '%s\n' "$1" | grep -Eq '^fd[0-9a-f]{2}(:[0-9a-f]{1,4}){2}:[0-9a-f]{3}0::/60$' ;;
	*) return 1 ;;
	esac
}

derive_addresses() {
	PREFIX_BASE="${1%::/64}"
	ROUTER_ADDRESS="${PREFIX_BASE}::1"
	LAN_PREFIX="$1"
	ADDRESS_PREFIX_LENGTH=64
}

derive_pd_addresses() {
	PREFIX_BASE="${1%::*}"
	ADDRESS_PREFIX_LENGTH="${1##*/}"
	ROUTER_ADDRESS="${PREFIX_BASE}::1"
	LAN_PREFIX="${PREFIX_BASE}::/64"
}

snapshot_create() {
	SNAPSHOT_DIR="$(mktemp -d /tmp/ipv6-test-mode.XXXXXX)" || return 1
	for package in $MANAGED_PACKAGES; do
		[ -f "/etc/config/$package" ] || return 1
		cp "/etc/config/$package" "$SNAPSHOT_DIR/$package" || return 1
	done
}

snapshot_restore() {
	[ -n "$SNAPSHOT_DIR" ] && [ -d "$SNAPSHOT_DIR" ] || return 1
	for package in $MANAGED_PACKAGES; do
		uci -q revert "$package"
		cp "$SNAPSHOT_DIR/$package" "/etc/config/$package" || return 1
	done
}

snapshot_remove() {
	[ -n "$SNAPSHOT_DIR" ] && [ -d "$SNAPSHOT_DIR" ] && rm -rf "$SNAPSHOT_DIR"
	SNAPSHOT_DIR=""
}

ensure_base_sections() {
	uci -q get network.lan >/dev/null || return 1
	uci -q get 'dhcp.@dnsmasq[0]' >/dev/null || return 1

	if ! uci -q get dhcp.lan >/dev/null; then
		uci -q set dhcp.lan='dhcp' || return 1
		uci -q set dhcp.lan.interface='lan' || return 1
	fi

	uci -q get firewall.@defaults[0] >/dev/null || return 1
	return 0
}

configure_common() {
	mode="$1"
	prefix="$2"

	uci -q delete network.lan.ip6prefix
	uci -q delete network.lan.ip6assign
	uci -q delete network.lan.ip6hint
	uci -q delete network.lan.ip6ifaceid
	uci -q delete network.lan.ip6class
	uci -q delete network.lan.ip6addr
	if [ "$mode" = "stateless_pd" ]; then
		derive_pd_addresses "$prefix"
		uci -q add_list network.lan.ip6prefix="$prefix,4294967295,4294967295,class=ipv6test" || return 1
		uci -q set network.lan.ip6assign="$ADDRESS_PREFIX_LENGTH" || return 1
		uci -q set network.lan.ip6ifaceid='::1' || return 1
		uci -q add_list network.lan.ip6class='ipv6test' || return 1
	else
		derive_addresses "$prefix"
		uci -q add_list network.lan.ip6addr="$ROUTER_ADDRESS/64" || return 1
	fi

	uci -q delete dhcp.lan.ignore
	uci -q set dhcp.lan.interface='lan' || return 1
	uci -q set dhcp.lan.dhcpv4='disabled' || return 1
	uci -q set dhcp.lan.dhcpv6='server' || return 1
	uci -q set dhcp.lan.dhcpv6_na='0' || return 1
	uci -q set dhcp.lan.dhcpv6_pd='0' || return 1
	uci -q delete dhcp.lan.dhcpv6_pd_min_len
	uci -q set dhcp.lan.ra='server' || return 1
	uci -q set dhcp.lan.ra_default='1' || return 1
	uci -q set dhcp.lan.ra_dns='0' || return 1
	uci -q delete dhcp.lan.ra_flags
	uci -q delete dhcp.lan.dns
	uci -q add_list dhcp.lan.dns="$ROUTER_ADDRESS" || return 1

	uci -q set 'dhcp.@dnsmasq[0].noresolv=1' || return 1
	uci -q set 'dhcp.@dnsmasq[0].localservice=1' || return 1
	uci -q set 'dhcp.@dnsmasq[0].domainneeded=1' || return 1
	uci -q delete 'dhcp.@dnsmasq[0].server'

	uci -q set dhcp.ipv6_test_router='domain' || return 1
	uci -q set dhcp.ipv6_test_router.name='router.ipv6.test' || return 1
	uci -q set dhcp.ipv6_test_router.ip="$ROUTER_ADDRESS" || return 1

	uci -q set firewall.ipv6_test_block='rule' || return 1
	uci -q set firewall.ipv6_test_block.name='IPv6 test mode: block forwarded traffic' || return 1
	uci -q set firewall.ipv6_test_block.src='lan' || return 1
	uci -q set firewall.ipv6_test_block.dest='*' || return 1
	uci -q set firewall.ipv6_test_block.proto='all' || return 1
	uci -q set firewall.ipv6_test_block.family='ipv6' || return 1
	uci -q set firewall.ipv6_test_block.target='REJECT' || return 1
	uci -q set firewall.ipv6_test_block.enabled='1' || return 1
}

configure_enabled() {
	mode="$1"
	prefix="$2"

	ensure_base_sections || return 1
	configure_common "$mode" "$prefix" || return 1

	case "$mode" in
	stateless)
		uci -q set dhcp.lan.ra_slaac='1' || return 1
		uci -q add_list dhcp.lan.ra_flags='other-config' || return 1
		;;
	stateful)
		uci -q set dhcp.lan.dhcpv6_na='1' || return 1
		uci -q set dhcp.lan.ra_slaac='0' || return 1
		uci -q add_list dhcp.lan.ra_flags='managed-config' || return 1
		;;
	stateless_pd)
		uci -q set dhcp.lan.dhcpv6_pd='1' || return 1
		uci -q set dhcp.lan.ra_slaac='1' || return 1
		uci -q add_list dhcp.lan.ra_flags='other-config' || return 1
		;;
	esac

	uci -q set "$APP_CONFIG.$APP_SECTION.initialized=1" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.enabled=1" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.mode=$mode" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.prefix=$prefix" || return 1
}

configure_disabled() {
	ensure_base_sections || return 1

	uci -q delete network.lan.ip6assign
	uci -q delete network.lan.ip6hint
	uci -q delete network.lan.ip6ifaceid
	uci -q delete network.lan.ip6class
	uci -q delete network.lan.ip6prefix
	uci -q delete network.lan.ip6addr

	uci -q delete dhcp.lan.ignore
	uci -q set dhcp.lan.interface='lan' || return 1
	uci -q set dhcp.lan.dhcpv4='disabled' || return 1
	uci -q set dhcp.lan.dhcpv6='disabled' || return 1
	uci -q set dhcp.lan.dhcpv6_na='0' || return 1
	uci -q set dhcp.lan.dhcpv6_pd='0' || return 1
	uci -q delete dhcp.lan.dhcpv6_pd_min_len
	uci -q set dhcp.lan.ra='disabled' || return 1
	uci -q set dhcp.lan.ra_slaac='0' || return 1
	uci -q set dhcp.lan.ra_dns='0' || return 1
	uci -q delete dhcp.lan.ra_flags
	uci -q delete dhcp.lan.dns
	uci -q delete dhcp.ipv6_test_router
	uci -q delete firewall.ipv6_test_block

	uci -q set "$APP_CONFIG.$APP_SECTION.initialized=1" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.enabled=0" || return 1
}

commit_managed_packages() {
	for package in $MANAGED_PACKAGES; do
		uci -q commit "$package" || return 1
	done
}

reload_services() {
	mkdir -p "$STATE_DIR"
	for action in \
		"network reload" \
		"dnsmasq restart" \
		"odhcpd restart" \
		"firewall reload"; do
		service="${action%% *}"
		verb="${action#* }"
		service_log="$STATE_DIR/service-$service-$verb.log"
		if ! /etc/init.d/"$service" "$verb" >"$service_log" 2>&1; then
			log_error "$service $verb failed; see $service_log"
			return 1
		fi
	done
}

rollback() {
	snapshot_restore || return 1
	reload_services >/dev/null 2>&1
}

service_running() {
	/etc/init.d/"$1" running >/dev/null 2>&1
}

bound_dhcpv6_addresses() {
	local lease_json="$1"
	local lease_device="$2"
	local lease_keys lease_key lease_flags address_keys address_key lease_address
	jshn -r "$lease_json" >/dev/null 2>&1 || return 1
	json_load "$lease_json" >/dev/null 2>&1 || return 1
	json_select device >/dev/null 2>&1 || return 0
	json_select "$lease_device" >/dev/null 2>&1 || return 0
	json_select leases >/dev/null 2>&1 || return 0
	json_get_keys lease_keys

	for lease_key in $lease_keys; do
		json_select "$lease_key" >/dev/null 2>&1 || continue
		lease_flags=""
		json_get_values lease_flags flags >/dev/null 2>&1 || lease_flags=""
		case " $lease_flags " in
		*" bound "*) ;;
		*)
			json_select ..
			continue
			;;
		esac

		if json_select ipv6-addr >/dev/null 2>&1; then
			json_get_keys address_keys
			for address_key in $address_keys; do
				json_select "$address_key" >/dev/null 2>&1 || continue
				json_get_var lease_address address
				[ -n "$lease_address" ] && printf '%s\n' "$lease_address"
				json_select ..
			done
			json_select ..
		fi
		json_select ..
	done
}

bound_dhcpv6_prefixes() {
	local lease_json="$1"
	local lease_device="$2"
	local lease_keys lease_key lease_flags prefix_keys prefix_key lease_prefix prefix_length
	jshn -r "$lease_json" >/dev/null 2>&1 || return 1
	json_load "$lease_json" >/dev/null 2>&1 || return 1
	json_select device >/dev/null 2>&1 || return 0
	json_select "$lease_device" >/dev/null 2>&1 || return 0
	json_select leases >/dev/null 2>&1 || return 0
	json_get_keys lease_keys

	for lease_key in $lease_keys; do
		json_select "$lease_key" >/dev/null 2>&1 || continue
		lease_flags=""
		json_get_values lease_flags flags >/dev/null 2>&1 || lease_flags=""
		case " $lease_flags " in
		*" bound "*) ;;
		*)
			json_select ..
			continue
			;;
		esac

		if json_select ipv6-prefix >/dev/null 2>&1; then
			json_get_keys prefix_keys
			for prefix_key in $prefix_keys; do
				json_select "$prefix_key" >/dev/null 2>&1 || continue
				lease_prefix=""
				prefix_length=""
				json_get_var lease_prefix address
				json_get_var prefix_length prefix-length
				[ -n "$lease_prefix" ] && [ -n "$prefix_length" ] && \
					printf '%s/%s\n' "$lease_prefix" "$prefix_length"
				json_select ..
			done
			json_select ..
		fi
		json_select ..
	done
}

usable_neighbor() {
	local neighbor_output="$1"
	local required_address="$2"
	printf '%s\n' "$neighbor_output" | awk -v required="$required_address" '
		BEGIN { required = tolower(required) }
		{
			address = tolower($1)
			state = $NF
			if (required != "" && address != required)
				next
			if (state ~ /^(REACHABLE|STALE|DELAY|PROBE)$/)
				print address "|" state
		}
	' | LC_ALL=C sort | sed -n '1p'
}

observe_client() {
	local client_device client_neighbors client_candidate client_leases client_addresses

	client_state="disabled"
	client_observed=0
	client_address=""
	client_method=""
	client_neighbor_state=""
	dhcpv6_bound=0
	client_error=""

	[ "$enabled" = "1" ] || return 0
	client_state="waiting"
	case "$mode" in
	stateful) client_method="dhcpv6" ;;
	*) client_method="slaac" ;;
	esac

	if ! network_get_device client_device lan || [ -z "$client_device" ]; then
		client_state="error"
		client_error="Could not resolve the LAN device."
		return 0
	fi

	if ! client_neighbors="$(ip -6 neigh show to "$prefix" dev "$client_device" 2>/dev/null)"; then
		client_state="error"
		client_error="Could not read the IPv6 neighbor table."
		return 0
	fi

	if [ "$mode" = "stateless" ] || [ "$mode" = "stateless_pd" ]; then
		client_candidate="$(usable_neighbor "$client_neighbors" "")"
		[ -n "$client_candidate" ] || return 0
		client_address="${client_candidate%%|*}"
		client_neighbor_state="${client_candidate#*|}"
		client_observed=1
		client_state="observed"
		return 0
	fi

	if ! client_leases="$(ubus call dhcp ipv6leases 2>/dev/null)"; then
		client_state="error"
		client_error="Could not read DHCPv6 leases."
		return 0
	fi
	if ! client_addresses="$(bound_dhcpv6_addresses "$client_leases" "$client_device")"; then
		client_state="error"
		client_error="Could not parse DHCPv6 leases."
		return 0
	fi
	client_address="$(printf '%s\n' "$client_addresses" | LC_ALL=C sort | sed -n '1p')"
	if [ -z "$client_address" ]; then
		return 0
	fi

	dhcpv6_bound=1
	client_state="assigned"
	client_candidate="$(usable_neighbor "$client_neighbors" "$client_address")"
	[ -n "$client_candidate" ] || return 0
	client_neighbor_state="${client_candidate#*|}"
	client_observed=1
	client_state="observed"
}

status_json() {
	enabled="$(uci -q get "$APP_CONFIG.$APP_SECTION.enabled")"
	mode="$(uci -q get "$APP_CONFIG.$APP_SECTION.mode")"
	prefix="$(normalize_prefix "$(uci -q get "$APP_CONFIG.$APP_SECTION.prefix")")"
	[ "$enabled" = "1" ] || enabled=0
	validate_mode "$mode" || mode="$DEFAULT_MODE"
	if [ "$mode" = "stateless_pd" ]; then
		validate_pd_prefix "$prefix" || prefix="$DEFAULT_PD_PREFIX"
		derive_pd_addresses "$prefix"
	else
		validate_prefix "$prefix" || prefix="$DEFAULT_PREFIX"
		derive_addresses "$prefix"
	fi

	address_active=0
	odhcpd_running=0
	dnsmasq_running=0
	firewall_running=0
	forwarding_blocked=0
	pd_server_enabled=0
	pd_lease_count=0
	delegated_prefix=""
	delegated_route_active=0

	ip -6 addr show 2>/dev/null | \
		grep -Fq "inet6 $ROUTER_ADDRESS/$ADDRESS_PREFIX_LENGTH " && address_active=1
	service_running odhcpd && odhcpd_running=1
	service_running dnsmasq && dnsmasq_running=1
	nft list table inet fw4 >/dev/null 2>&1 && firewall_running=1
	if [ "$firewall_running" = "1" ] && \
		nft list table inet fw4 2>/dev/null | grep -Fq 'IPv6 test mode: block forwarded traffic'; then
		forwarding_blocked=1
	fi
	if [ "$mode" = "stateless_pd" ] && \
		[ "$(uci -q get dhcp.lan.dhcpv6_pd)" = "1" ]; then
		pd_server_enabled=1
		if client_device=""; network_get_device client_device lan && [ -n "$client_device" ]; then
			if client_leases="$(ubus call dhcp ipv6leases 2>/dev/null)"; then
				delegated_prefixes="$(bound_dhcpv6_prefixes "$client_leases" "$client_device")"
				delegated_prefix="$(printf '%s\n' "$delegated_prefixes" | sed '/^$/d' | LC_ALL=C sort | sed -n '1p')"
				pd_lease_count="$(printf '%s\n' "$delegated_prefixes" | sed '/^$/d' | wc -l | tr -d ' ')"
				[ -n "$delegated_prefix" ] && \
					ip -6 route show 2>/dev/null | grep -Fq "$delegated_prefix " && \
					delegated_route_active=1
			fi
		fi
	fi

	if [ "$enabled" = "1" ] && [ "$address_active" = "1" ] && \
		[ "$odhcpd_running" = "1" ] && [ "$dnsmasq_running" = "1" ] && \
		[ "$forwarding_blocked" = "1" ]; then
		ok=1
		active_mode="$mode"
	elif [ "$enabled" = "0" ]; then
		ok=1
		active_mode="disabled"
	else
		ok=0
		active_mode="degraded"
	fi

	case "$mode" in
	stateful) ra_flags="A=0 O=0 M=1" ;;
	*) ra_flags="A=1 O=1 M=0" ;;
	esac
	observe_client

	json_init
	json_add_boolean ok "$ok"
	json_add_boolean enabled "$enabled"
	json_add_string mode "$mode"
	json_add_string active_mode "$active_mode"
	json_add_string prefix "$prefix"
	json_add_string lan_prefix "$LAN_PREFIX"
	json_add_string router_address "$ROUTER_ADDRESS"
	json_add_string dns_address "$ROUTER_ADDRESS"
	json_add_string dns_name "router.ipv6.test"
	json_add_string ra_flags "$ra_flags"
	json_add_boolean default_gateway "$enabled"
	json_add_boolean address_active "$address_active"
	json_add_boolean odhcpd_running "$odhcpd_running"
	json_add_boolean dnsmasq_running "$dnsmasq_running"
	json_add_boolean firewall_running "$firewall_running"
	json_add_boolean forwarding_blocked "$forwarding_blocked"
	json_add_boolean pd_server_enabled "$pd_server_enabled"
	json_add_int pd_lease_count "$pd_lease_count"
	json_add_string delegated_prefix "$delegated_prefix"
	json_add_boolean delegated_route_active "$delegated_route_active"
	json_add_string client_state "$client_state"
	json_add_boolean client_observed "$client_observed"
	json_add_string client_address "$client_address"
	json_add_string client_method "$client_method"
	json_add_string client_neighbor_state "$client_neighbor_state"
	json_add_boolean dhcpv6_bound "$dhcpv6_bound"
	json_add_string client_error "$client_error"
	json_add_string client_action "Reconnect or renew the client after changing modes."
	json_add_string error "$(read_last_error)"
	json_dump
}

apply_enabled() {
	mode="$1"
	prefix="$(normalize_prefix "$2")"
	do_reload="$3"

	if ! validate_mode "$mode"; then
		set_last_error "Mode must be stateless, stateful, or stateless_pd."
		status_json
		return 1
	fi
	if [ "$mode" = "stateless_pd" ] && ! validate_pd_prefix "$prefix"; then
		set_last_error "Delegation prefix must be a normalized, nibble-aligned ULA /48, /52, /56, or /60."
		status_json
		return 1
	elif [ "$mode" != "stateless_pd" ] && ! validate_prefix "$prefix"; then
		set_last_error "Prefix must use normalized ULA /64 form: fdxx:xxxx:xxxx:xxxx::/64."
		status_json
		return 1
	fi

	if [ "$do_reload" = "1" ]; then
		snapshot_create || {
			snapshot_remove
			set_last_error "Could not create a configuration rollback snapshot."
			status_json
			return 1
		}
	fi

	if ! configure_enabled "$mode" "$prefix" || ! commit_managed_packages; then
		[ "$do_reload" = "1" ] && rollback
		snapshot_remove
		set_last_error "Could not save the IPv6 test configuration."
		status_json
		return 1
	fi

	if [ "$do_reload" = "1" ] && ! reload_services; then
		rollback
		snapshot_remove
		set_last_error "A network service rejected the new configuration; the previous configuration was restored."
		status_json
		return 1
	fi

	snapshot_remove
	clear_last_error
	status_json
}

apply_disabled() {
	do_reload="$1"

	if [ "$do_reload" = "1" ]; then
		snapshot_create || {
			snapshot_remove
			set_last_error "Could not create a configuration rollback snapshot."
			status_json
			return 1
		}
	fi

	if ! configure_disabled || ! commit_managed_packages; then
		[ "$do_reload" = "1" ] && rollback
		snapshot_remove
		set_last_error "Could not disable IPv6 test mode."
		status_json
		return 1
	fi

	if [ "$do_reload" = "1" ] && ! reload_services; then
		rollback
		snapshot_remove
		set_last_error "A network service rejected the disabled configuration; the previous configuration was restored."
		status_json
		return 1
	fi

	snapshot_remove
	clear_last_error
	status_json
}

case "$1" in
apply)
	apply_enabled "$2" "$3" 1
	;;
disable)
	apply_disabled 1
	;;
seed)
	apply_enabled "$DEFAULT_MODE" "$DEFAULT_PREFIX" 0 >/dev/null
	;;
boot)
	if [ "$(uci -q get "$APP_CONFIG.$APP_SECTION.enabled")" = "1" ]; then
		apply_enabled \
			"$(uci -q get "$APP_CONFIG.$APP_SECTION.mode")" \
			"$(uci -q get "$APP_CONFIG.$APP_SECTION.prefix")" 1
	else
		apply_disabled 1
	fi
	;;
status)
	status_json
	;;
*)
	echo "Usage: $0 {apply <stateless|stateful> <ula-prefix/64>|apply stateless_pd <ula-prefix/48|52|56|60>|disable|seed|boot|status}" >&2
	exit 2
	;;
esac
