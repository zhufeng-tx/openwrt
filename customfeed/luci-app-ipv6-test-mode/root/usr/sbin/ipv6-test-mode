#!/bin/sh
# shellcheck disable=SC3043 # OpenWrt ash provides local variables.

# shellcheck source=/dev/null
. /usr/share/libubox/jshn.sh
# shellcheck source=/dev/null
. /lib/functions/network.sh

APP_CONFIG="ipv6test"
APP_SECTION="main"
DEFAULT_MODE="stateless"
DEFAULT_PREFIX="fd42:6970:7636:1::/64"
DEFAULT_DOWNSTREAM_PREFIX="fd42:6970:7636:1:a69::/80"
STATE_DIR="/tmp/ipv6-test-mode"
LAST_ERROR_FILE="$STATE_DIR/last_error"
FORWARDING_STATE_FILE="$STATE_DIR/forwarding-before-proxy"
NDPPD_CONFIG="/etc/ndppd.conf"
NDPPD_PIDFILE="/var/run/ndppd.pid"
DHCPV6_CONFIG="/tmp/ipv6-test-dhcpv6.conf"
DHCPV6_LEASES="/tmp/ipv6-test-dhcpv6.leases"
MANAGED_PACKAGES="network dhcp firewall $APP_CONFIG"
UPSTREAM_NETWORK="ipv6_test_upstream"
DOWNSTREAM_NETWORK="ipv6_test_downstream"
UPSTREAM_DEVICE="eth0.10"
DOWNSTREAM_DEVICE="eth0.20"

log_error() { logger -t ipv6-test-mode "$1"; }

set_last_error() {
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$1" > "$LAST_ERROR_FILE"
	log_error "$1"
}

clear_last_error() { rm -f "$LAST_ERROR_FILE"; }
read_last_error() { [ -r "$LAST_ERROR_FILE" ] && sed -n '1p' "$LAST_ERROR_FILE"; }

validate_mode() {
	case "$1" in stateless|stateful|ndp_proxy) return 0 ;; *) return 1 ;; esac
}

normalize_prefix() { printf '%s' "$1" | tr 'A-F' 'a-f'; }

validate_prefix() {
	printf '%s\n' "$1" | grep -Eq '^fd[0-9a-f]{2}(:[0-9a-f]{1,4}){3}::/64$'
}

validate_downstream_prefix() {
	upstream="$1"
	downstream="$2"
	printf '%s\n' "$downstream" | grep -Eq '^fd[0-9a-f]{2}(:[0-9a-f]{1,4}){4}::/80$' || return 1
	upstream_base="${upstream%::/64}"
	downstream_base="${downstream%::/80}"
	case "$downstream_base" in "$upstream_base":*) return 0 ;; *) return 1 ;; esac
}

derive_addresses() {
	PREFIX_BASE="${1%::/64}"
	ROUTER_ADDRESS="${PREFIX_BASE}::1"
}

derive_proxy_addresses() {
	UPSTREAM_BASE="${1%::/64}"
	DOWNSTREAM_BASE="${2%::/80}"
	UPSTREAM_ROUTER_ADDRESS="${UPSTREAM_BASE}::1"
	UPSTREAM_ADDRESS="${UPSTREAM_BASE}::a69"
	DOWNSTREAM_ROUTER_ADDRESS="${DOWNSTREAM_BASE}::1"
}

service_running() { /etc/init.d/"$1" running >/dev/null 2>&1; }

ndppd_running() {
	[ -s "$NDPPD_PIDFILE" ] || return 1
	pid="$(sed -n '1p' "$NDPPD_PIDFILE")"
	[ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1
}

dhcpv6_server_running() {
	service_running ipv6-test-dhcpv6
}

current_forwarding() {
	cat /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null
}

remember_forwarding_state() {
	[ -f "$FORWARDING_STATE_FILE" ] && return 0
	value="$(current_forwarding)"
	case "$value" in 0|1) ;; *) return 1 ;; esac
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$value" > "$FORWARDING_STATE_FILE"
}

restore_forwarding_state() {
	[ -f "$FORWARDING_STATE_FILE" ] || return 0
	value="$(sed -n '1p' "$FORWARDING_STATE_FILE")"
	case "$value" in 0|1) ;; *) return 1 ;; esac
	printf '%s\n' "$value" > /proc/sys/net/ipv6/conf/all/forwarding || return 1
	rm -f "$FORWARDING_STATE_FILE"
}

snapshot_create() {
	SNAPSHOT_DIR="$(mktemp -d /tmp/ipv6-test-mode.XXXXXX)" || return 1
	for package in $MANAGED_PACKAGES; do
		[ -f "/etc/config/$package" ] || return 1
		cp "/etc/config/$package" "$SNAPSHOT_DIR/$package" || return 1
	done
	if [ -f "$NDPPD_CONFIG" ]; then
		cp "$NDPPD_CONFIG" "$SNAPSHOT_DIR/ndppd.conf" || return 1
		touch "$SNAPSHOT_DIR/ndppd.conf.exists"
	fi
	if [ -f "$DHCPV6_CONFIG" ]; then
		cp "$DHCPV6_CONFIG" "$SNAPSHOT_DIR/ipv6-test-dhcpv6.conf" || return 1
		touch "$SNAPSHOT_DIR/ipv6-test-dhcpv6.conf.exists"
	fi
	current_forwarding > "$SNAPSHOT_DIR/forwarding.current" || return 1
	if [ -f "$FORWARDING_STATE_FILE" ]; then
		cp "$FORWARDING_STATE_FILE" "$SNAPSHOT_DIR/forwarding-before-proxy" || return 1
		touch "$SNAPSHOT_DIR/forwarding-before-proxy.exists"
	fi
	[ -x /etc/init.d/ndppd ] && /etc/init.d/ndppd enabled >/dev/null 2>&1 && touch "$SNAPSHOT_DIR/ndppd.enabled"
	ndppd_running && touch "$SNAPSHOT_DIR/ndppd.running"
	/etc/init.d/ipv6-test-dhcpv6 enabled >/dev/null 2>&1 && touch "$SNAPSHOT_DIR/dhcpv6.enabled"
	dhcpv6_server_running && touch "$SNAPSHOT_DIR/dhcpv6.running"
	return 0
}

snapshot_restore() {
	[ -n "$SNAPSHOT_DIR" ] && [ -d "$SNAPSHOT_DIR" ] || return 1
	for package in $MANAGED_PACKAGES; do
		uci -q revert "$package"
		cp "$SNAPSHOT_DIR/$package" "/etc/config/$package" || return 1
	done
	if [ -f "$SNAPSHOT_DIR/ndppd.conf.exists" ]; then
		cp "$SNAPSHOT_DIR/ndppd.conf" "$NDPPD_CONFIG" || return 1
	else
		rm -f "$NDPPD_CONFIG"
	fi
	if [ -f "$SNAPSHOT_DIR/ipv6-test-dhcpv6.conf.exists" ]; then
		cp "$SNAPSHOT_DIR/ipv6-test-dhcpv6.conf" "$DHCPV6_CONFIG" || return 1
	else
		rm -f "$DHCPV6_CONFIG" "$DHCPV6_LEASES"
	fi
	if [ -f "$SNAPSHOT_DIR/forwarding-before-proxy.exists" ]; then
		cp "$SNAPSHOT_DIR/forwarding-before-proxy" "$FORWARDING_STATE_FILE" || return 1
	else
		rm -f "$FORWARDING_STATE_FILE"
	fi
}

snapshot_restore_ndppd() {
	[ -x /etc/init.d/ndppd ] || return 0
	if [ -f "$SNAPSHOT_DIR/ndppd.enabled" ]; then
		/etc/init.d/ndppd enable >/dev/null 2>&1 || return 1
	else
		/etc/init.d/ndppd disable >/dev/null 2>&1 || return 1
	fi
	if [ -f "$SNAPSHOT_DIR/ndppd.running" ]; then
		/etc/init.d/ndppd restart >/dev/null 2>&1 || return 1
	else
		/etc/init.d/ndppd stop >/dev/null 2>&1 || true
	fi
}

snapshot_restore_dhcpv6() {
	if [ -f "$SNAPSHOT_DIR/dhcpv6.enabled" ]; then
		/etc/init.d/ipv6-test-dhcpv6 enable >/dev/null 2>&1 || return 1
	else
		/etc/init.d/ipv6-test-dhcpv6 disable >/dev/null 2>&1 || return 1
	fi
	if [ -f "$SNAPSHOT_DIR/dhcpv6.running" ]; then
		/etc/init.d/ipv6-test-dhcpv6 restart >/dev/null 2>&1 || return 1
	else
		/etc/init.d/ipv6-test-dhcpv6 stop >/dev/null 2>&1 || true
	fi
}

snapshot_restore_forwarding() {
	value="$(sed -n '1p' "$SNAPSHOT_DIR/forwarding.current")"
	case "$value" in 0|1) ;; *) return 1 ;; esac
	printf '%s\n' "$value" > /proc/sys/net/ipv6/conf/all/forwarding
}

snapshot_remove() {
	[ -n "$SNAPSHOT_DIR" ] && [ -d "$SNAPSHOT_DIR" ] && rm -rf "$SNAPSHOT_DIR"
	SNAPSHOT_DIR=""
	return 0
}

ensure_base_sections() {
	uci -q get network.lan >/dev/null || return 1
	uci -q get 'dhcp.@dnsmasq[0]' >/dev/null || return 1
	if ! uci -q get dhcp.lan >/dev/null; then
		uci -q set dhcp.lan='dhcp' || return 1
		uci -q set dhcp.lan.interface='lan' || return 1
	fi
	uci -q get firewall.@defaults[0] >/dev/null || return 1
}

delete_proxy_sections() {
	for section in ipv6_test_vlan10 ipv6_test_vlan20 "$UPSTREAM_NETWORK" "$DOWNSTREAM_NETWORK"; do
		uci -q delete "network.$section"
	done
	uci -q delete "dhcp.$DOWNSTREAM_NETWORK"
	for section in ipv6_test_up_zone ipv6_test_down_zone ipv6_test_up_to_down ipv6_test_down_to_up; do
		uci -q delete "firewall.$section"
	done
	return 0
}

write_ndppd_disabled() {
	[ -x /etc/init.d/ndppd ] || return 0
	temporary="${NDPPD_CONFIG}.ipv6-test.$$"
	umask 077
	printf '# Managed by luci-app-ipv6-test-mode; proxy mode is disabled.\n' > "$temporary" || return 1
	mv "$temporary" "$NDPPD_CONFIG"
}

write_ndppd_proxy() {
	downstream_prefix="$1"
	[ -x /etc/init.d/ndppd ] || return 1
	temporary="${NDPPD_CONFIG}.ipv6-test.$$"
	umask 077
	{
		printf 'route-ttl 30000\n\n'
		printf 'proxy %s {\n' "$UPSTREAM_DEVICE"
		printf '    router yes\n    timeout 500\n    ttl 30000\n'
		printf '    rule %s {\n' "$downstream_prefix"
		printf '        iface %s\n    }\n}\n' "$DOWNSTREAM_DEVICE"
	} > "$temporary" || return 1
	mv "$temporary" "$NDPPD_CONFIG"
}

write_dhcpv6_disabled() {
	rm -f "$DHCPV6_CONFIG" "$DHCPV6_LEASES"
}

write_dhcpv6_proxy() {
	downstream_prefix="$1"
	dns_address="$2"
	downstream_base="${downstream_prefix%::/80}"
	temporary="${DHCPV6_CONFIG}.ipv6-test.$$"
	umask 077
	{
		printf 'port=0\n'
		printf 'interface=%s\n' "$DOWNSTREAM_DEVICE"
		printf 'bind-dynamic\n'
		printf 'dhcp-authoritative\n'
		printf 'dhcp-sequential-ip\n'
		printf 'dhcp-range=%s::100,%s::ffff,80,12h\n' "$downstream_base" "$downstream_base"
		printf 'dhcp-option=option6:dns-server,[%s]\n' "$dns_address"
		printf 'dhcp-leasefile=%s\n' "$DHCPV6_LEASES"
		printf 'log-dhcp\n'
	} > "$temporary" || return 1
	mv "$temporary" "$DHCPV6_CONFIG"
	rm -f "$DHCPV6_LEASES"
}

configure_dns() {
	dns_address="$1"
	uci -q set 'dhcp.@dnsmasq[0].noresolv=1' || return 1
	uci -q set 'dhcp.@dnsmasq[0].localservice=1' || return 1
	uci -q set 'dhcp.@dnsmasq[0].domainneeded=1' || return 1
	uci -q delete 'dhcp.@dnsmasq[0].server'
	uci -q set dhcp.ipv6_test_router='domain' || return 1
	uci -q set dhcp.ipv6_test_router.name='router.ipv6.test' || return 1
	uci -q set dhcp.ipv6_test_router.ip="$dns_address" || return 1
}

configure_legacy() {
	mode="$1"
	prefix="$2"
	derive_addresses "$prefix"
	delete_proxy_sections
	write_ndppd_disabled || return 1
	write_dhcpv6_disabled || return 1
	uci -q delete network.lan.ip6assign
	uci -q delete network.lan.ip6addr
	uci -q add_list network.lan.ip6addr="$ROUTER_ADDRESS/64" || return 1
	uci -q delete dhcp.lan.ignore
	uci -q set dhcp.lan.interface='lan' || return 1
	uci -q set dhcp.lan.instance='ipv6_test_odhcpd_only' || return 1
	uci -q set dhcp.lan.dhcpv4='disabled' || return 1
	uci -q set dhcp.lan.dhcpv6='server' || return 1
	uci -q set dhcp.lan.ra='server' || return 1
	uci -q set dhcp.lan.ra_default='1' || return 1
	uci -q set dhcp.lan.ra_dns='0' || return 1
	uci -q delete dhcp.lan.ra_flags
	uci -q delete dhcp.lan.dns
	uci -q add_list dhcp.lan.dns="$ROUTER_ADDRESS" || return 1
	case "$mode" in
		stateless)
			uci -q set dhcp.lan.ra_slaac='1' || return 1
			uci -q add_list dhcp.lan.ra_flags='other-config' || return 1
			;;
		stateful)
			uci -q set dhcp.lan.ra_slaac='0' || return 1
			uci -q add_list dhcp.lan.ra_flags='managed-config' || return 1
			;;
	esac
	configure_dns "$ROUTER_ADDRESS" || return 1
	uci -q set firewall.ipv6_test_block='rule' || return 1
	uci -q set firewall.ipv6_test_block.name='IPv6 test mode: block forwarded traffic' || return 1
	uci -q set firewall.ipv6_test_block.src='lan' || return 1
	uci -q set firewall.ipv6_test_block.dest='*' || return 1
	uci -q set firewall.ipv6_test_block.proto='all' || return 1
	uci -q set firewall.ipv6_test_block.family='ipv6' || return 1
	uci -q set firewall.ipv6_test_block.target='REJECT' || return 1
	uci -q set firewall.ipv6_test_block.enabled='1' || return 1
}

configure_proxy_device() {
	section="$1"; name="$2"; vid="$3"
	uci -q set "network.$section=device" || return 1
	uci -q set "network.$section.name=$name" || return 1
	uci -q set "network.$section.type=8021q" || return 1
	uci -q set "network.$section.ifname=eth0" || return 1
	uci -q set "network.$section.vid=$vid" || return 1
}

configure_proxy_interface() {
	section="$1"; device="$2"; address="$3"
	uci -q set "network.$section=interface" || return 1
	uci -q set "network.$section.proto=static" || return 1
	uci -q set "network.$section.device=$device" || return 1
	uci -q delete "network.$section.ip6addr"
	uci -q add_list "network.$section.ip6addr=$address" || return 1
	uci -q set "network.$section.delegate=0" || return 1
}

configure_proxy() {
	upstream_prefix="$1"; downstream_prefix="$2"
	remember_forwarding_state || return 1
	derive_proxy_addresses "$upstream_prefix" "$downstream_prefix"
	delete_proxy_sections
	write_ndppd_proxy "$downstream_prefix" || return 1
	write_dhcpv6_proxy "$downstream_prefix" "$DOWNSTREAM_ROUTER_ADDRESS" || return 1
	uci -q delete network.lan.ip6assign
	uci -q delete network.lan.ip6addr
	uci -q delete dhcp.lan.ignore
	uci -q set dhcp.lan.interface='lan' || return 1
	uci -q set dhcp.lan.instance='ipv6_test_odhcpd_only' || return 1
	uci -q set dhcp.lan.dhcpv4='disabled' || return 1
	uci -q set dhcp.lan.dhcpv6='disabled' || return 1
	uci -q set dhcp.lan.ra='disabled' || return 1
	uci -q set dhcp.lan.ra_slaac='0' || return 1
	uci -q delete dhcp.lan.ra_flags
	uci -q delete dhcp.lan.dns
	configure_proxy_device ipv6_test_vlan10 "$UPSTREAM_DEVICE" 10 || return 1
	configure_proxy_device ipv6_test_vlan20 "$DOWNSTREAM_DEVICE" 20 || return 1
	configure_proxy_interface "$UPSTREAM_NETWORK" "$UPSTREAM_DEVICE" "$UPSTREAM_ADDRESS/64" || return 1
	configure_proxy_interface "$DOWNSTREAM_NETWORK" "$DOWNSTREAM_DEVICE" "$DOWNSTREAM_ROUTER_ADDRESS/80" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK=dhcp" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.interface=$DOWNSTREAM_NETWORK" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.instance=ipv6_test_odhcpd_only" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.dhcpv4=disabled" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.dhcpv6=disabled" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.ra=server" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.ra_default=1" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.ra_slaac=0" || return 1
	uci -q set "dhcp.$DOWNSTREAM_NETWORK.ra_dns=0" || return 1
	uci -q delete "dhcp.$DOWNSTREAM_NETWORK.ra_flags"
	uci -q add_list "dhcp.$DOWNSTREAM_NETWORK.ra_flags=managed-config" || return 1
	uci -q delete "dhcp.$DOWNSTREAM_NETWORK.dns"
	uci -q add_list "dhcp.$DOWNSTREAM_NETWORK.dns=$DOWNSTREAM_ROUTER_ADDRESS" || return 1
	configure_dns "$DOWNSTREAM_ROUTER_ADDRESS" || return 1
	uci -q delete firewall.ipv6_test_block
	for direction in up down; do
		section="ipv6_test_${direction}_zone"
		uci -q set "firewall.$section=zone" || return 1
		uci -q set "firewall.$section.name=ipv6_test_$direction" || return 1
		uci -q set "firewall.$section.input=ACCEPT" || return 1
		uci -q set "firewall.$section.output=ACCEPT" || return 1
		uci -q set "firewall.$section.forward=REJECT" || return 1
	done
	uci -q add_list "firewall.ipv6_test_up_zone.network=$UPSTREAM_NETWORK" || return 1
	uci -q add_list "firewall.ipv6_test_down_zone.network=$DOWNSTREAM_NETWORK" || return 1
	uci -q set firewall.ipv6_test_up_to_down='rule' || return 1
	uci -q set firewall.ipv6_test_up_to_down.name='IPv6 test proxy: upstream to downstream' || return 1
	uci -q set firewall.ipv6_test_up_to_down.src='ipv6_test_up' || return 1
	uci -q set firewall.ipv6_test_up_to_down.dest='ipv6_test_down' || return 1
	uci -q set firewall.ipv6_test_up_to_down.family='ipv6' || return 1
	uci -q set firewall.ipv6_test_up_to_down.dest_ip="$downstream_prefix" || return 1
	uci -q set firewall.ipv6_test_up_to_down.proto='all' || return 1
	uci -q set firewall.ipv6_test_up_to_down.target='ACCEPT' || return 1
	uci -q set firewall.ipv6_test_down_to_up='rule' || return 1
	uci -q set firewall.ipv6_test_down_to_up.name='IPv6 test proxy: downstream to upstream' || return 1
	uci -q set firewall.ipv6_test_down_to_up.src='ipv6_test_down' || return 1
	uci -q set firewall.ipv6_test_down_to_up.dest='ipv6_test_up' || return 1
	uci -q set firewall.ipv6_test_down_to_up.family='ipv6' || return 1
	uci -q set firewall.ipv6_test_down_to_up.src_ip="$downstream_prefix" || return 1
	uci -q set firewall.ipv6_test_down_to_up.proto='all' || return 1
	uci -q set firewall.ipv6_test_down_to_up.target='ACCEPT' || return 1
}

configure_enabled() {
	mode="$1"; prefix="$2"; downstream_prefix="$3"
	ensure_base_sections || return 1
	case "$mode" in ndp_proxy) configure_proxy "$prefix" "$downstream_prefix" ;; *) configure_legacy "$mode" "$prefix" ;; esac || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.initialized=1" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.enabled=1" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.mode=$mode" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.prefix=$prefix" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.downstream_prefix=$downstream_prefix" || return 1
}

configure_disabled() {
	ensure_base_sections || return 1
	delete_proxy_sections
	write_ndppd_disabled || return 1
	write_dhcpv6_disabled || return 1
	uci -q delete network.lan.ip6assign
	uci -q delete network.lan.ip6addr
	uci -q delete dhcp.lan.ignore
	uci -q set dhcp.lan.interface='lan' || return 1
	uci -q set dhcp.lan.instance='ipv6_test_odhcpd_only' || return 1
	uci -q set dhcp.lan.dhcpv4='disabled' || return 1
	uci -q set dhcp.lan.dhcpv6='disabled' || return 1
	uci -q set dhcp.lan.ra='disabled' || return 1
	uci -q set dhcp.lan.ra_slaac='0' || return 1
	uci -q set dhcp.lan.ra_dns='0' || return 1
	uci -q delete dhcp.lan.ra_flags
	uci -q delete dhcp.lan.dns
	uci -q delete dhcp.ipv6_test_router
	uci -q delete firewall.ipv6_test_block
	uci -q set "$APP_CONFIG.$APP_SECTION.initialized=1" || return 1
	uci -q set "$APP_CONFIG.$APP_SECTION.enabled=0" || return 1
}

commit_managed_packages() {
	for package in $MANAGED_PACKAGES; do uci -q commit "$package" || return 1; done
}

reload_base_services() {
	mkdir -p "$STATE_DIR"
	for action in "network reload" "dnsmasq restart" "odhcpd restart" "firewall reload"; do
		service_name="${action%% *}"
		service_action="${action#* }"
		service_log="$STATE_DIR/service-$service_name-$service_action.log"
		/etc/init.d/"$service_name" "$service_action" >"$service_log" 2>&1 || {
			log_error "$service_name $service_action failed; see $service_log"
			return 1
		}
	done
}

wait_proxy_ready() {
	downstream_prefix="$1"; attempt=0
	while [ "$attempt" -lt 15 ]; do
		if ip link show "$UPSTREAM_DEVICE" >/dev/null 2>&1 && \
			ip link show "$DOWNSTREAM_DEVICE" >/dev/null 2>&1 && \
			ip -6 route show 2>/dev/null | grep -Fq "$downstream_prefix dev $DOWNSTREAM_DEVICE"; then
			return 0
		fi
		attempt=$((attempt + 1)); sleep 1
	done
	return 1
}

wait_ndppd_ready() {
	attempt=0
	while [ "$attempt" -lt 10 ]; do
		ndppd_running && return 0
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

reload_services() {
	mode="$1"; downstream_prefix="$2"
	reload_base_services || return 1
	[ -x /etc/init.d/ndppd ] || [ "$mode" != "ndp_proxy" ] || return 1
	if [ "$mode" = "ndp_proxy" ]; then
		wait_proxy_ready "$downstream_prefix" || return 1
		printf '1\n' > /proc/sys/net/ipv6/conf/all/forwarding || return 1
		/etc/init.d/ndppd enable >/dev/null 2>&1 || return 1
		/etc/init.d/ndppd stop >/dev/null 2>&1 || true
		rm -f "$NDPPD_PIDFILE"
		/etc/init.d/ndppd start >"$STATE_DIR/service-ndppd-restart.log" 2>&1 || return 1
		wait_ndppd_ready || return 1
		/etc/init.d/ipv6-test-dhcpv6 enable >/dev/null 2>&1 || return 1
		/etc/init.d/ipv6-test-dhcpv6 restart >"$STATE_DIR/service-dhcpv6-restart.log" 2>&1 || return 1
		dhcpv6_server_running || return 1
	else
		if [ -x /etc/init.d/ndppd ]; then
			/etc/init.d/ndppd stop >/dev/null 2>&1 || true
			/etc/init.d/ndppd disable >/dev/null 2>&1 || return 1
		fi
		/etc/init.d/ipv6-test-dhcpv6 stop >/dev/null 2>&1 || true
		/etc/init.d/ipv6-test-dhcpv6 disable >/dev/null 2>&1 || return 1
		restore_forwarding_state || return 1
	fi
}

rollback() {
	snapshot_restore || return 1
	reload_base_services >/dev/null 2>&1 || return 1
	snapshot_restore_ndppd || return 1
	snapshot_restore_dhcpv6 || return 1
	snapshot_restore_forwarding
}

bound_dhcpv6_addresses() {
	local lease_json="$1" lease_device="$2"
	local lease_keys lease_key lease_flags address_keys address_key lease_address
	jshn -r "$lease_json" >/dev/null 2>&1 || return 1
	json_load "$lease_json" >/dev/null 2>&1 || return 1
	json_select device >/dev/null 2>&1 || return 0
	json_select "$lease_device" >/dev/null 2>&1 || return 0
	json_select leases >/dev/null 2>&1 || return 0
	json_get_keys lease_keys
	for lease_key in $lease_keys; do
		json_select "$lease_key" >/dev/null 2>&1 || continue
		lease_flags=""; json_get_values lease_flags flags >/dev/null 2>&1 || lease_flags=""
		case " $lease_flags " in *" bound "*) ;; *) json_select ..; continue ;; esac
		if json_select ipv6-addr >/dev/null 2>&1; then
			json_get_keys address_keys
			for address_key in $address_keys; do
				json_select "$address_key" >/dev/null 2>&1 || continue
				json_get_var lease_address address
				[ -n "$lease_address" ] && printf '%s\n' "$lease_address"
				json_select ..
			done
			json_select ..
		fi
		json_select ..
	done
}

usable_neighbor() {
	printf '%s\n' "$1" | awk -v required="$2" '
		BEGIN { required = tolower(required) }
		{ address = tolower($1); state = $NF
		  if (required != "" && address != required) next
		  if (state ~ /^(REACHABLE|STALE|DELAY|PROBE)$/) print address "|" state }
	' | LC_ALL=C sort | sed -n '1p'
}

first_address_in_prefix() {
	addresses="$1"
	address_prefix="$2"
	address_base="${address_prefix%::/64}"
	[ "$address_base" != "$address_prefix" ] || address_base="${address_prefix%::/80}"
	printf '%s\n' "$addresses" | \
		awk -v base="$(printf '%s' "$address_base" | tr 'A-F' 'a-f')" \
		'{ address=tolower($0); if (index(address, base ":") == 1) print address }' | \
		LC_ALL=C sort | sed -n '1p'
}

observe_client() {
	local client_network observed_prefix client_device client_neighbors client_candidate client_leases client_addresses
	client_state="disabled"; client_observed=0; client_address=""; client_method=""
	client_neighbor_state=""; dhcpv6_bound=0; client_error=""
	[ "$enabled" = "1" ] || return 0
	client_state="waiting"
	case "$mode" in stateful|ndp_proxy) client_method="dhcpv6" ;; *) client_method="slaac" ;; esac
	if [ "$mode" = "ndp_proxy" ]; then
		client_network="$DOWNSTREAM_NETWORK"; observed_prefix="$downstream_prefix"
	else
		client_network="lan"; observed_prefix="$prefix"
	fi
	if ! network_get_device client_device "$client_network" || [ -z "$client_device" ]; then
		client_state="error"; client_error="Could not resolve the client-facing device."; return 0
	fi
	if ! client_neighbors="$(ip -6 neigh show to "$observed_prefix" dev "$client_device" 2>/dev/null)"; then
		client_state="error"; client_error="Could not read the IPv6 neighbor table."; return 0
	fi
	if [ "$mode" = "stateless" ]; then
		client_candidate="$(usable_neighbor "$client_neighbors" "")"
		[ -n "$client_candidate" ] || return 0
		client_address="${client_candidate%%|*}"; client_neighbor_state="${client_candidate#*|}"
		client_observed=1; client_state="observed"; return 0
	fi
	if [ "$mode" = "ndp_proxy" ]; then
		[ -r "$DHCPV6_LEASES" ] || return 0
		client_addresses="$(awk '{ for (i=1; i<=NF; i++) if ($i ~ /:/) print $i }' "$DHCPV6_LEASES")"
		client_address="$(first_address_in_prefix "$client_addresses" "$observed_prefix")"
		[ -n "$client_address" ] || return 0
		dhcpv6_bound=1; client_state="assigned"
		client_candidate="$(usable_neighbor "$client_neighbors" "$client_address")"
		[ -n "$client_candidate" ] || return 0
		client_neighbor_state="${client_candidate#*|}"; client_observed=1; client_state="observed"
		return 0
	fi
	if ! client_leases="$(ubus call dhcp ipv6leases 2>/dev/null)"; then
		client_state="error"; client_error="Could not read DHCPv6 leases."; return 0
	fi
	if ! client_addresses="$(bound_dhcpv6_addresses "$client_leases" "$client_device")"; then
		client_state="error"; client_error="Could not parse DHCPv6 leases."; return 0
	fi
	client_address="$(first_address_in_prefix "$client_addresses" "$observed_prefix")"
	[ -n "$client_address" ] || return 0
	dhcpv6_bound=1; client_state="assigned"
	client_candidate="$(usable_neighbor "$client_neighbors" "$client_address")"
	[ -n "$client_candidate" ] || return 0
	client_neighbor_state="${client_candidate#*|}"; client_observed=1; client_state="observed"
}

status_json() {
	enabled="$(uci -q get "$APP_CONFIG.$APP_SECTION.enabled")"
	mode="$(uci -q get "$APP_CONFIG.$APP_SECTION.mode")"
	prefix="$(normalize_prefix "$(uci -q get "$APP_CONFIG.$APP_SECTION.prefix")")"
	downstream_prefix="$(normalize_prefix "$(uci -q get "$APP_CONFIG.$APP_SECTION.downstream_prefix")")"
	[ "$enabled" = "1" ] || enabled=0
	validate_mode "$mode" || mode="$DEFAULT_MODE"
	validate_prefix "$prefix" || prefix="$DEFAULT_PREFIX"
	validate_downstream_prefix "$prefix" "$downstream_prefix" || downstream_prefix="$DEFAULT_DOWNSTREAM_PREFIX"
	derive_addresses "$prefix"; derive_proxy_addresses "$prefix" "$downstream_prefix"
	address_active=0; upstream_address_active=0; downstream_address_active=0; route_active=0
	odhcpd_running=0; dnsmasq_running=0; firewall_running=0; forwarding_blocked=0
	forwarding_allowed=0; ndppd_active=0; topology="single_lan"; status_router_address="$ROUTER_ADDRESS"
	dhcpv6_server_active=0
	ip -6 addr show 2>/dev/null | grep -Fq "inet6 $ROUTER_ADDRESS/64 " && address_active=1
	service_running odhcpd && odhcpd_running=1
	service_running dnsmasq && dnsmasq_running=1
	nft list table inet fw4 >/dev/null 2>&1 && firewall_running=1
	if [ "$firewall_running" = "1" ] && nft list table inet fw4 2>/dev/null | grep -Fq 'IPv6 test mode: block forwarded traffic'; then
		forwarding_blocked=1
	fi
	if [ "$mode" = "ndp_proxy" ]; then
		topology="vlan_proxy"; status_router_address="$DOWNSTREAM_ROUTER_ADDRESS"
		ip -6 addr show dev "$UPSTREAM_DEVICE" 2>/dev/null | grep -Fq "inet6 $UPSTREAM_ADDRESS/64 " && upstream_address_active=1
		ip -6 addr show dev "$DOWNSTREAM_DEVICE" 2>/dev/null | grep -Fq "inet6 $DOWNSTREAM_ROUTER_ADDRESS/80 " && downstream_address_active=1
		[ "$downstream_address_active" = "1" ] && address_active=1
		ip -6 route show 2>/dev/null | grep -Fq "$downstream_prefix dev $DOWNSTREAM_DEVICE" && route_active=1
		ndppd_running && ndppd_active=1
		dhcpv6_server_running && dhcpv6_server_active=1
		if [ "$(cat /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null)" = "1" ] && \
			[ "$firewall_running" = "1" ] && nft list table inet fw4 2>/dev/null | grep -Fq 'IPv6 test proxy: upstream to downstream'; then
			forwarding_allowed=1
		fi
	fi
	if [ "$enabled" = "0" ]; then
		ok=1; active_mode="disabled"
	elif [ "$mode" = "ndp_proxy" ] && [ "$upstream_address_active" = "1" ] && [ "$downstream_address_active" = "1" ] && \
		[ "$route_active" = "1" ] && [ "$ndppd_active" = "1" ] && [ "$dhcpv6_server_active" = "1" ] && \
		[ "$forwarding_allowed" = "1" ] && \
		[ "$odhcpd_running" = "1" ] && [ "$dnsmasq_running" = "1" ]; then
		ok=1; active_mode="$mode"
	elif [ "$mode" != "ndp_proxy" ] && [ "$address_active" = "1" ] && [ "$odhcpd_running" = "1" ] && \
		[ "$dnsmasq_running" = "1" ] && [ "$forwarding_blocked" = "1" ]; then
		ok=1; active_mode="$mode"
	else
		ok=0; active_mode="degraded"
	fi
	case "$mode" in stateful|ndp_proxy) ra_flags="A=0 O=0 M=1" ;; *) ra_flags="A=1 O=1 M=0" ;; esac
	observe_client
	json_init
	json_add_boolean ok "$ok"; json_add_boolean enabled "$enabled"
	json_add_string mode "$mode"; json_add_string active_mode "$active_mode"; json_add_string topology "$topology"
	json_add_string prefix "$prefix"; json_add_string downstream_prefix "$downstream_prefix"
	json_add_string upstream_device "$UPSTREAM_DEVICE"; json_add_string downstream_device "$DOWNSTREAM_DEVICE"
	json_add_string router_address "$status_router_address"; json_add_string upstream_address "$UPSTREAM_ADDRESS"
	json_add_string upstream_router_address "$UPSTREAM_ROUTER_ADDRESS"; json_add_string dns_address "$status_router_address"
	json_add_string dns_name "router.ipv6.test"; json_add_string ra_flags "$ra_flags"
	json_add_boolean default_gateway "$enabled"; json_add_boolean address_active "$address_active"
	json_add_boolean upstream_address_active "$upstream_address_active"; json_add_boolean downstream_address_active "$downstream_address_active"
	json_add_boolean route_active "$route_active"; json_add_boolean ndppd_running "$ndppd_active"
	json_add_boolean dhcpv6_server_running "$dhcpv6_server_active"
	json_add_boolean forwarding_allowed "$forwarding_allowed"; json_add_boolean odhcpd_running "$odhcpd_running"
	json_add_boolean dnsmasq_running "$dnsmasq_running"; json_add_boolean firewall_running "$firewall_running"
	json_add_boolean forwarding_blocked "$forwarding_blocked"; json_add_string client_state "$client_state"
	json_add_boolean client_observed "$client_observed"; json_add_string client_address "$client_address"
	json_add_string client_method "$client_method"; json_add_string client_neighbor_state "$client_neighbor_state"
	json_add_boolean dhcpv6_bound "$dhcpv6_bound"; json_add_string client_error "$client_error"
	json_add_string client_action "Reconnect or renew the client after changing modes."
	json_add_string error "$(read_last_error)"; json_dump
}

apply_enabled() {
	mode="$1"; prefix="$(normalize_prefix "$2")"; downstream_prefix="$(normalize_prefix "$3")"; do_reload="$4"
	[ -n "$downstream_prefix" ] || downstream_prefix="$DEFAULT_DOWNSTREAM_PREFIX"
	if ! validate_mode "$mode"; then set_last_error "Mode must be stateless, stateful, or ndp_proxy."; status_json; return 1; fi
	if ! validate_prefix "$prefix"; then
		set_last_error "Prefix must use normalized ULA /64 form: fdxx:xxxx:xxxx:xxxx::/64."; status_json; return 1
	fi
	if [ "$mode" = "ndp_proxy" ] && ! validate_downstream_prefix "$prefix" "$downstream_prefix"; then
		set_last_error "Downstream prefix must be a normalized ULA /80 contained by the upstream /64."; status_json; return 1
	fi
	if [ "$do_reload" = "1" ]; then
		snapshot_create || { snapshot_remove; set_last_error "Could not create a configuration rollback snapshot."; status_json; return 1; }
	fi
	if ! configure_enabled "$mode" "$prefix" "$downstream_prefix" || ! commit_managed_packages; then
		[ "$do_reload" = "1" ] && rollback; snapshot_remove
		set_last_error "Could not save the IPv6 test configuration."; status_json; return 1
	fi
	if [ "$do_reload" = "1" ] && ! reload_services "$mode" "$downstream_prefix"; then
		rollback; snapshot_remove
		set_last_error "A network service rejected the new configuration; the previous configuration was restored."; status_json; return 1
	fi
	snapshot_remove; clear_last_error; status_json
}

apply_disabled() {
	do_reload="$1"
	if [ "$do_reload" = "1" ]; then
		snapshot_create || { snapshot_remove; set_last_error "Could not create a configuration rollback snapshot."; status_json; return 1; }
	fi
	if ! configure_disabled || ! commit_managed_packages; then
		[ "$do_reload" = "1" ] && rollback; snapshot_remove
		set_last_error "Could not disable IPv6 test mode."; status_json; return 1
	fi
	if [ "$do_reload" = "1" ] && ! reload_services disabled "$DEFAULT_DOWNSTREAM_PREFIX"; then
		rollback; snapshot_remove
		set_last_error "A network service rejected the disabled configuration; the previous configuration was restored."; status_json; return 1
	fi
	snapshot_remove; clear_last_error; status_json
}

case "$1" in
	apply) apply_enabled "$2" "$3" "$4" 1 ;;
	disable) apply_disabled 1 ;;
	seed) apply_enabled "$DEFAULT_MODE" "$DEFAULT_PREFIX" "$DEFAULT_DOWNSTREAM_PREFIX" 0 >/dev/null ;;
	boot)
		if [ "$(uci -q get "$APP_CONFIG.$APP_SECTION.enabled")" = "1" ]; then
			apply_enabled "$(uci -q get "$APP_CONFIG.$APP_SECTION.mode")" \
				"$(uci -q get "$APP_CONFIG.$APP_SECTION.prefix")" \
				"$(uci -q get "$APP_CONFIG.$APP_SECTION.downstream_prefix")" 1
		else
			apply_disabled 1
		fi
		;;
	status) status_json ;;
	*)
		echo "Usage: $0 {apply <stateless|stateful> <ula-prefix/64>|apply ndp_proxy <ula-prefix/64> <contained-ula-prefix/80>|disable|seed|boot|status}" >&2
		exit 2
		;;
esac
