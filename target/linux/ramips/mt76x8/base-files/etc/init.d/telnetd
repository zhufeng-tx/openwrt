#!/bin/sh /etc/rc.common

START=50
STOP=50
USE_PROCD=1

PROG=/usr/sbin/telnetd
LOGIN=/bin/login
PORT=23

start_service() {
	[ -x "$PROG" ] || return 1
	[ -x "$LOGIN" ] || return 1

	procd_open_instance
	procd_set_param command "$PROG" -F -l "$LOGIN" -p "$PORT"
	procd_set_param respawn
	procd_close_instance
}
