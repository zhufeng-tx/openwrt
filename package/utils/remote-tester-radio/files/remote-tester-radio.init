#!/bin/sh /etc/rc.common
START=90
USE_PROCD=1
PROG=/usr/sbin/remote-tester-radio

start_service() {
	config_load remote-tester-radio
	config_get enabled main enabled 1
	config_get disabled main disabled 0
	[ "$enabled" = 1 ] && [ "$disabled" = 0 ] || return
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param file /etc/config/remote-tester-radio
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger remote-tester-radio
}
