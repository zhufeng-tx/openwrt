config radio 'main'
	option enabled '1'
	option disabled '0'
	option spidev '/dev/spidev0.1'
	option gpiochip '/dev/gpiochip0'
	option reset_line 'LORA_RESET_N'
	option busy_line 'LORA_BUSY'
	option dio1_line 'LORA_DIO1'
	option txen_line 'LORA_TXEN'
	option rxen_line 'LORA_RXEN'
	option spi_hz '2000000'
	option frequency_mhz '433'
	option bandwidth_khz '125'
	option spreading_factor '7'
	option coding_rate '5'
	option sync_word '0x1424'
	option allow_tx_test '0'
