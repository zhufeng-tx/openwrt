config radio 'main'
	option enabled '1'
	option disabled '0'
	option spidev '/dev/spidev0.1'
	option gpiochip '/dev/gpiochip0'
	option reset_line 'LORA_RESET_N'
	option busy_line 'LORA_BUSY'
	option dio1_line 'LORA_DIO1'
	option txen_line 'LORA_TXEN'
	option rxen_line 'LORA_RXEN'
	option spi_hz '2000000'
	option frequency_mhz '433'
	option bandwidth_khz '125'
	option spreading_factor '7'
	option coding_rate '5'
	option sync_word '0x1424'
	option allow_tx_test '0'
	# Network operation is inert until both the role and TX gates are configured.
	option role 'diagnostic'
	option network_tx_enabled '0'
	option antenna_confirmed '0'
	option lab_mode '0'
	option network_id '1'
	option host_port '45671'
	option node_port '45670'
	option host_uart '/dev/ttyS1'
	option serial_device '/dev/ttyS1'
	option host_psk_file '/etc/remote-tester-radio/host.psk'
	option beacon_key_file '/etc/remote-tester-radio/beacon.key'
	option node_psk_file '/etc/remote-tester-radio/node.psk'
	option node_registry_file '/etc/remote-tester-radio/nodes.keys'
	option advertise_ipv4 ''
	option controller_ipv4 ''
	option node_eui ''
	option queue_bytes '2097152'
